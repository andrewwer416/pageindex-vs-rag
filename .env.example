# LLM endpoint and models. LiteLLM routes by model prefix:
#   ollama_chat/<name>  → uses LLM_API_BASE for ollama  (no /v1 suffix)
#   openai/<name>       → uses LLM_API_BASE as OpenAI-compatible server (usually ends in /v1)
#
# Example A — local Ollama:
#   LLM_API_BASE=http://localhost:11434
#   INDEX_MODEL=ollama_chat/qwen3:14b
#   ANSWER_MODEL=ollama_chat/qwen3:8b
#   RETRIEVE_MODEL=ollama_chat/deepseek-r1:14b
#
# Example B — local OpenAI-compatible server (vLLM, llama.cpp server, LM Studio, etc.):
#   LLM_API_BASE=http://localhost:8000/v1
#   LLM_API_KEY=<your-token-or-not-needed>
#   INDEX_MODEL=openai/gemma-3-27b-it
#   ANSWER_MODEL=openai/gemma-3-27b-it
#   RETRIEVE_MODEL=openai/gemma-3-27b-it
#
# Notes for Example B:
#   - The `openai/` prefix tells LiteLLM "speak the OpenAI Chat Completions API."
#     Any server that implements `/v1/chat/completions` works — gemma served via
#     vLLM, llama.cpp's server, LM Studio, Ollama's `/v1` compatibility shim, etc.
#   - The model string AFTER `openai/` must match what your server registered
#     it as. Check with: `curl $LLM_API_BASE/models`.
#   - If your server doesn't authenticate, set LLM_API_KEY to any non-empty
#     string — LiteLLM still requires one syntactically.
#
# Example C — OpenAI hosted (paid):
#   LLM_API_BASE=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   INDEX_MODEL=openai/gpt-4o
#   ANSWER_MODEL=openai/gpt-4o
#   RETRIEVE_MODEL=openai/o1

LLM_API_BASE=http://localhost:11434
LLM_API_KEY=not-needed

INDEX_MODEL=ollama_chat/qwen3:14b
ANSWER_MODEL=ollama_chat/qwen3:8b
RETRIEVE_MODEL=ollama_chat/deepseek-r1:14b

# Embedding model used for the traditional-RAG pipeline (sentence-transformers).
EMBED_MODEL=BAAI/bge-small-en-v1.5
CHUNK_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
RAG_TOP_K=5

# Ollama-specific knobs. Ignored for non-Ollama backends.
OLLAMA_NUM_CTX=32768
LLM_TIMEOUT=1800

# Display name of the document; surfaces in the UI.
DOC_NAME=Tesla 10-K (FY 2024)
