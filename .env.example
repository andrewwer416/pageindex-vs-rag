# ── Required ──────────────────────────────────────────────────────────────────

# Where the LLM lives. LiteLLM picks the right env var based on the MODEL prefix:
#   ollama_chat/<name>  → uses LLM_API_BASE as an Ollama endpoint (no /v1 suffix)
#   openai/<name>       → uses LLM_API_BASE as an OpenAI-compatible endpoint
#                          (usually ends in /v1)
LLM_API_BASE=http://localhost:11434

# A single model name used for indexing, answering, AND retrieval-side reasoning.
# (You can override any role individually — see Optional section below.)
MODEL=ollama_chat/qwen3:14b

# Set to any non-empty string for local servers that don't authenticate;
# LiteLLM requires the variable to exist.
LLM_API_KEY=not-needed


# ── Worked examples ──────────────────────────────────────────────────────────
#
# Local Ollama:
#   LLM_API_BASE=http://localhost:11434
#   MODEL=ollama_chat/qwen3:14b
#
# Local OpenAI-compatible server (vLLM, llama.cpp server, LM Studio, Ollama's
# /v1 shim, …) serving gemma — what you'd use for a self-hosted gemma endpoint:
#   LLM_API_BASE=http://localhost:8000/v1
#   MODEL=openai/gemma-3-27b-it
#   LLM_API_KEY=<your-token-or-any-non-empty-string>
#
# OpenAI hosted (paid):
#   LLM_API_BASE=https://api.openai.com/v1
#   MODEL=openai/gpt-4o
#   LLM_API_KEY=sk-...
#
# Groq free tier:
#   LLM_API_BASE=https://api.groq.com/openai/v1
#   MODEL=openai/llama-3.3-70b-versatile
#   LLM_API_KEY=gsk-...
#
# To find the exact model name your OpenAI-compatible server expects:
#   curl $LLM_API_BASE/models


# ── Optional: per-role model overrides ───────────────────────────────────────
# Leave commented out to use MODEL for all three roles.
#
# INDEX_MODEL=<one-off heavier model used only when rebuilding the tree>
# ANSWER_MODEL=<smaller/faster model for final answers>
# RETRIEVE_MODEL=<a reasoning/thinking model surfaces a richer trace here>


# ── Embedding (traditional-RAG pipeline only — not the same as the LLM) ──────
EMBED_MODEL=BAAI/bge-small-en-v1.5
CHUNK_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
RAG_TOP_K=5


# ── Ollama-only knobs (ignored for OpenAI-compatible backends) ───────────────
OLLAMA_NUM_CTX=32768
LLM_TIMEOUT=1800


# ── UI ────────────────────────────────────────────────────────────────────────
DOC_NAME=Tesla 10-K (FY 2024)
