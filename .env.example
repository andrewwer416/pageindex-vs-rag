# ── Required ──────────────────────────────────────────────────────────────────

# Base URL of your OpenAI-compatible LLM endpoint. Should usually end in /v1.
# This is the same value you'd pass to OpenAI(base_url=...) in the Python SDK.
LLM_API_BASE=http://localhost:11434/v1

# Model name the server expects in the chat-completions request. This is
# whatever you'd pass to client.chat.completions.create(model="..."). To
# discover what your server accepts, run: curl $LLM_API_BASE/models
MODEL=qwen3:14b


# ── Optional auth + transport ────────────────────────────────────────────────

# Bearer token. Set to any non-empty string for servers that don't authenticate;
# the openai SDK requires the parameter to exist.
LLM_API_KEY=not-needed

# Header name to send LLM_API_KEY in. Defaults to the SDK's standard
# "Authorization: Bearer <key>". Set this if your server expects a custom
# header instead — e.g. corporate gateways often use "apikey" or "x-api-key".
# When set, the SDK's default Authorization header is suppressed so the two
# don't conflict.
# LLM_API_KEY_HEADER=apikey

# Extra request headers (beyond the API-key one above). JSON or "K1:V1;K2:V2":
#   LLM_HEADERS={"X-Tenant-Id": "abc", "X-Trace": "true"}
#   LLM_HEADERS=X-Tenant-Id:abc;X-Trace:true
# LLM_HEADERS=

# Server TLS-cert verification. Set to a CA-bundle PEM path if your server
# uses a private CA (corporate root etc.). Equivalent to httpx.Client(verify=...).
# LLM_CA_BUNDLE=/path/to/internal-ca.pem

# Client cert for mutual TLS. Either a single combined PEM or "cert:key":
# LLM_CLIENT_CERT=/path/to/client.pem
# LLM_CLIENT_CERT=/path/to/cert.pem:/path/to/key.pem

# Set to "false" to disable server-cert verification entirely (testing only).
# LLM_VERIFY_SSL=true

# Per-call timeout in seconds. Bump for slow local inference.
LLM_TIMEOUT=1800


# ── Worked examples ──────────────────────────────────────────────────────────
#
# Local Ollama (its OpenAI shim is at port 11434/v1):
#   LLM_API_BASE=http://localhost:11434/v1
#   MODEL=qwen3:14b
#
# Local OpenAI-compatible server (vLLM, llama.cpp, LM Studio, internal gemma,…):
#   LLM_API_BASE=http://your-host:8000/v1
#   MODEL=gemma-3-27b-it
#
# Internal/enterprise endpoint behind a private CA, with the API key sent in
# a custom "apikey" header (instead of standard Authorization):
#   LLM_API_BASE=https://genai.internal.example.com/v1
#   MODEL=/genai/model
#   LLM_API_KEY=<your-key>
#   LLM_API_KEY_HEADER=apikey
#   LLM_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem
#
# Hosted OpenAI:
#   LLM_API_BASE=https://api.openai.com/v1
#   MODEL=gpt-4o
#   LLM_API_KEY=sk-...


# ── Per-role overrides (default to MODEL if unset) ───────────────────────────
# INDEX_MODEL=<one-off heavier model used only when rebuilding the tree>
# ANSWER_MODEL=<smaller/faster model for final answers>
# RETRIEVE_MODEL=<a reasoning/thinking model surfaces a richer trace here>


# ── Embedding (traditional-RAG pipeline only — not the same as the LLM) ──────
#
# EMBED_PROVIDER picks where embeddings come from:
#   "sentence-transformers" (default) — local HuggingFace model, no network.
#                                       EMBED_MODEL must be a downloadable HF id
#                                       (e.g. BAAI/bge-small-en-v1.5) or a local
#                                       path to a cached model.
#   "openai"                          — call an OpenAI-compatible /v1/embeddings
#                                       endpoint. Reuses your LLM auth/CA/headers
#                                       config by default. EMBED_MODEL must be
#                                       whatever model name the server expects.
#
# IMPORTANT: the committed FAISS index was built with BAAI/bge-small-en-v1.5
# (384 dimensions). If you switch EMBED_MODEL or EMBED_PROVIDER, you must also
# rebuild it: `PYTHONPATH=. python scripts/build_index.py rag`

EMBED_PROVIDER=sentence-transformers
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional EMBED_* overrides (fall back to LLM_* if unset).
# Set these only if your embedder lives at a different URL / uses different auth
# from your chat-completions endpoint.
# EMBED_API_BASE=https://embedder.internal.example.com/v1
# EMBED_API_KEY=...
# EMBED_API_KEY_HEADER=apikey
# EMBED_CA_BUNDLE=/path/to/internal-ca.pem
# EMBED_HEADERS={"X-Tenant": "demo"}

CHUNK_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
RAG_TOP_K=5


# ── Optional: vision-language preprocessing of PDFs ──────────────────────────
#
# When enabled, image regions of each PDF page are sent to a vision-capable
# model at index time and the description is injected into the page text.
# This makes scanned PDFs, charts, diagrams, and screenshots queryable via
# both pipelines. Heavy: adds one VLM call per image (and one per scanned
# page) at indexing time. Off by default.
#
# All VISION_* settings fall back to the matching LLM_* if unset, so a
# single endpoint serving both chat and vision needs no extra config.

# VISION_ENABLED=true
# VISION_MODEL=gemma-3-27b-it          # must accept OpenAI multimodal content format
# VISION_API_BASE=...                  # falls back to LLM_API_BASE
# VISION_API_KEY=...                   # falls back to LLM_API_KEY
# VISION_API_KEY_HEADER=apikey         # falls back to LLM_API_KEY_HEADER
# VISION_CA_BUNDLE=...                 # falls back to LLM_CA_BUNDLE
# VISION_MIN_PIXELS=40000              # skip images smaller than this (≈ 200×200)
# VISION_MAX_PER_PAGE=6                # cap describable images per page


# ── UI ────────────────────────────────────────────────────────────────────────
DOC_NAME=Tesla 10-K (FY 2024)

# Hide the "System status" expander in the UI (set to "false" to hide).
# SHOW_SYSTEM_STATUS=true

# Show the developer debug panel (set to "true" to show — off by default).
# STREAMLIT_DEBUG=false
